# =============================================================================
# 2026 玉山人工智慧公開挑戰賽 — 環境變數設定範本 (.env.example)
# =============================================================================
# 請複製此檔案為 `.env` 並填入真實金鑰（`.env` 已列入 .gitignore 不會上傳至 Git）

# Google Gemini API 金鑰 (供 LiteLLM Router 呼叫 gemini/... 模型使用)
GEMINI_API_KEY=your_gemini_api_key_here

# 參賽隊伍 ID
TEAM_ID=TEAM_11402

# 玉山 AI 挑戰賽後台登入帳密 (供 L0_sources/backend_history_loader.py 自動抓取官方歷史數據)
ESUN_EMAIL=your_email@example.com
ESUN_PASSWORD=your_password_here

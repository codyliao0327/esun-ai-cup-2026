              {
                "type": "text",
                "text": "2.",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "text": "shares = 0",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": "、但 "
              },
              {
                "type": "text",
                "text": "receivable_shares \u003e 0",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": "的標的不需要出現在 "
              },
              {
                "type": "text",
                "text": "decisions",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": " 或 "
              },
              {
                "type": "text",
                "text": "no_trade_decisions",
                "style": {
                  "code": true
                }
              }
            ]
          }
        ]
      }
    ],
